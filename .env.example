# Copy to .env for local Compose use. Replace every placeholder with your own values.
# Never commit .env or put real credentials in this example file.
BOT_SERVICE_TOKEN=replace-with-a-private-bot-service-token
ADMIN_SERVICE_TOKEN=replace-with-a-private-admin-service-token
TELEGRAM_BOT_ID=000000000
TELEGRAM_USER_ID=000000000
TELEGRAM_PRIVATE_CHAT_ID=000000000
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token

# Optional bounded Gemini ranking. Leave disabled for deterministic ranking only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FREE_TIER_ACKNOWLEDGED=false
AI_MAX_INPUT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=512

# Optional host-side PostgreSQL port (defaults to 5432).
DB_HOST_PORT=5432
