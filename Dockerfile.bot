FROM rust:1.94-alpine AS build
RUN apk add --no-cache musl-dev
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY bot ./bot
RUN cargo build --release

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=build /build/target/release/study-habit-engine-bot /usr/local/bin/study-habit-engine-bot
CMD ["study-habit-engine-bot"]
